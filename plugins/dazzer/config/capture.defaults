# Tuning for the end-of-reply backstop. Plain name=value, one per line.
#
# This file is READ, never run. It is data, so nothing here can execute on your machine.
# Setting any of these in your environment overrides the value here.
#
# Every name below is also in the README's tuning table, and a check keeps the two lists
# identical - a setting that gets added without being documented fails the build.

# How much new conversation has to accumulate before a save is prompted, counted in
# entries. Raise it for fewer checkpoints, lower it to capture more eagerly.
#
# 80 was far too eager. Measured over three hundred real conversations it worked out at a
# checkpoint every three or four messages a person typed, and about one per message in the
# busiest sessions - where a single reply that reads files and runs commands adds eighty
# entries on its own. At 250 the same sessions get one roughly every six messages, and a
# quiet conversation one every twenty.
DAZZER_CAPTURE_THRESHOLD=250

# The most of the incoming message we will read at once. A guard against a pathological
# payload, not a tuning dial - there is no reason to change it.
DAZZER_CAPTURE_MAX_INPUT_BYTES=100000

# How long a finished session's marker is kept before it is tidied away. These are a few
# bytes each, but one is created per session forever, so something has to remove them.
DAZZER_CAPTURE_STATE_TTL_DAYS=30

# How large the record of what this did may grow before the old one is rolled aside.
DAZZER_CAPTURE_RECEIPTS_MAX_BYTES=262144

# Which tool this is running inside, recorded in the run history so the two can be told
# apart. Left empty on purpose: it works itself out, and is only set by hand somewhere the
# guess is wrong.
DAZZER_TOOL=

# Which moment this is running in, set by the trigger that runs it rather than by a person.
# Left empty on purpose: a tool wired only at the end of a reply says nothing here and gets
# the behaviour it has always had. There is no reason to set this by hand.
DAZZER_MOMENT=
